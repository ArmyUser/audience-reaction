# Audience Reaction: local configuration.
# Copy to .env and fill in your own values: cp .env.example .env
# .env is git-ignored. Never commit it, and never prefix these with NEXT_PUBLIC_: every value is read on the server
# only and is never sent to the browser.
# Demo mode needs none of these keys.

# --- Provider keys ---

# TypeSafe Jev: comment classification (question set jev-q2.2) and topic assignment (jev-topic-a1).
# Needed for test datasets with the real AI pipeline, real YouTube analysis, and Jev benchmarks.
JEV_API_KEY=

# Anthropic: topic discovery and consolidation (claude-sonnet-5-5).
# Needed for test datasets with the real AI pipeline, real YouTube analysis, and topic benchmarks.
ANTHROPIC_API_KEY=

# YouTube Data API v3: fetches a video's top-level comments (commentThreads.list). Real YouTube analysis only.
# Sent only to the YouTube Data API as its `key` query parameter; redacted from every log and error.
YOUTUBE_API_KEY=

# Optional. Google Gemini, used only by the topic benchmarks' alternative discovery provider (--provider gemini).
# GEMINI_API_KEY=

# --- Default analysis source (the Analyze page can change it per analysis) ---

# "demo" (default): synthetic comments and a rule-based classifier, no provider calls.
# "real": the real AI pipeline, with the source below.
# ANALYSIS_MODE=demo

# With ANALYSIS_MODE=real: "fixture" (a synthetic development dataset) or "youtube" (default).
# Real YouTube analysis also requires the CG-1 gate; see README "YouTube integration and CG-1".
# ANALYSIS_SOURCE=fixture

# With ANALYSIS_SOURCE=fixture: t1-topics-v1 (default) or m2 (m2-synthetic). Validation and hold-out sets are refused.
# FIXTURE_DATASET=t1-topics-v1
